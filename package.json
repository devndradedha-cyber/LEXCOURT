{
  "name": "lexcourt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Free, mobile-first, privacy-first helper for people in U.S. immigration court without a lawyer.",
  "scripts": {
    "ocr-assets": "node scripts/copy-ocr-assets.mjs",
    "predev": "npm run ocr-assets",
    "dev": "vite",
    "prebuild": "npm run ocr-assets",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretest": "npm run ocr-assets",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "review-doc": "vite-node scripts/export-review-doc.mts"
  },
  "dependencies": {
    "@fontsource/noto-nastaliq-urdu": "5.3.0",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@fontsource/noto-sans-gurmukhi": "5.3.0",
    "pdfjs-dist": "4.10.38",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tesseract.js": "5.1.1"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/spa": "1.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "docx": "9.7.1",
    "typescript": "5.6.3",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  },
  "overrides": {
    "wasm-feature-detect": "1.6.2"
  }
}
